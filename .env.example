# Local OAuth development values. Replace the placeholders before signing in.
SQLDC_BASE_URL=http://localhost:8000
SQLDC_GOOGLE_REDIRECT_URI=http://localhost:8000/api/google-callback.php
SQLDC_GOOGLE_CLIENT_ID=replace-with-google-web-client-id
SQLDC_GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret

# true selects local SQLite; false requires the configured MySQL database.
DEV_MODE=true
# SQLDC_DB_HOST=your-mysql-host
# SQLDC_DB_PORT=3306
# SQLDC_DB_NAME=your-sqldc-database
# SQLDC_DB_USER=your-sqldc-user
# SQLDC_DB_PASSWORD=replace-with-database-password

$env:DEV_MODE = "true"
$env:SQLDC_BASE_URL = "http://127.0.0.1:8000"
$env:SQLDC_GOOGLE_REDIRECT_URI = "http://127.0.0.1:8000/api/google-callback.php"
$env:SQLDC_GOOGLE_CLIENT_ID = "<your Google client ID>"
$env:SQLDC_GOOGLE_CLIENT_SECRET = "<your Google client secret>"
php -S 127.0.0.1:8000
